# AI 동화 낭독기 설정

# --- 서버 ---
# 내부망 주소 (HTTPS 인증서에 들어갈 IP, 쉼표로 여러 개)
SERVER_IPS=192.168.0.10

# --- TTS (이 앱이 직접 올리는 스트리밍 모델) ---
TTS_MODEL=./models/Qwen3-TTS-12Hz-1.7B-CustomVoice
# 어텐션 구현: sdpa (기본) / flash_attention_2
TTS_ATTN=sdpa
# torch.compile + CUDA graph 최적화 (1 = 켬, 시작 시 약 2분 컴파일 후 실시간보다 빠름)
STREAM_OPTIMIZE=1

# --- STT / 그림 모델 (상대 경로는 이 폴더 기준) ---
WHISPER_PATH=./models/whisper-large-v3-turbo
SDXL_BASE=./models/sdxl-base
SDXL_VAE=./models/sdxl-vae-fp16-fix
SDXL_UNET=./models/sdxl-lightning/sdxl_lightning_4step_unet.safetensors
DEVICE=cuda:0
# 로컬 모델만 사용 (인터넷 접속 안 함)
HF_HUB_OFFLINE=1

# --- LLM: 내부 네트워크 로컬 모델(OpenAI 호환)만 사용. think 는 끔 ---
LLM_DEFAULT=FREETOKEN
STRATA_BASE_URL=http://<STRATA-서버-IP>:<포트>/v1
STRATA_API_KEY=
# 비우면 서버 /models 의 첫 모델
STRATA_MODEL=
FREETOKEN_BASE_URL=http://<FREETOKEN-서버-IP>:<포트>/v1
FREETOKEN_API_KEY=
FREETOKEN_MODEL=

# 그림 모델 GPU 상주 (1) / CPU 오프로드 (0). 상주 후 GPU 여유가 PAINT_MIN_FREE_GB 보다 적으면 자동 오프로드
PAINT_ON_GPU=1
PAINT_MIN_FREE_GB=1.5

# 주인공 모습 일관성 (IP-Adapter): 1 = 켬. REF_SCALE 은 표지를 따르는 정도 (0.2 권장, 0.3 이상이면 장면이 표지를 닮아 감)
CHARACTER_REF=1
REF_SCALE=0.2
